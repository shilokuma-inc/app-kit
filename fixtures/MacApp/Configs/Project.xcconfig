//
//  Project.xcconfig
//  FixtureMacApp
//
//  プロジェクト共通のビルド設定（fixtures/App と同じ形）。
//

// Apple Developer Program の Team ID
DEVELOPMENT_TEAM = XU74X3434S

// アプリ本体の Bundle Identifier。
// テストターゲットは $(APP_BUNDLE_IDENTIFIER).Tests / .UITests として派生させる
APP_BUNDLE_IDENTIFIER = jp.shilokuma.FixtureMacApp

// バージョン（CFBundleShortVersionString / CFBundleVersion）
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// 最低サポート OS
MACOSX_DEPLOYMENT_TARGET = 14.0

// entitlements のファイル。push（com.apple.developer.aps-environment）は provisioning profile が要り、profile の無いアドホック署名では
// ビルドが「requires a provisioning profile」で止まる。app-kit の Build・Archive のアドホック署名は CODE_SIGN_STYLE=Manual にするので、
// 自動の署名のときだけ push のあるファイルを使う。配布の Archive には、app-kit の app-archive.yml が Archive の後に足す
FIXTURE_ENTITLEMENTS_Automatic = FixtureMacApp/FixtureMacApp-Distribution.entitlements
FIXTURE_ENTITLEMENTS_Manual = FixtureMacApp/FixtureMacApp.entitlements
