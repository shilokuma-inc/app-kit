//
//  Project.xcconfig
//  FixtureExtensionApp
//
//  プロジェクト共通のビルド設定（fixtures/App と同じ形）。
//

// Apple Developer Program の Team ID
DEVELOPMENT_TEAM = XU74X3434S

// アプリ本体の Bundle Identifier。ウィジェットは $(APP_BUNDLE_IDENTIFIER).Widget として派生させる
APP_BUNDLE_IDENTIFIER = jp.shilokuma.FixtureExtensionApp

// アプリとウィジェットが共有する App Group（entitlements のファイルの $(APP_GROUP_IDENTIFIER)）。
// shariverse/oshikatsu-countdown-ios と同じく、ビルドの設定の変数で書く（app-kit が Archive の後に展開して入れる）
APP_GROUP_IDENTIFIER = group.$(APP_BUNDLE_IDENTIFIER)

// バージョン（CFBundleShortVersionString / CFBundleVersion）
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// 最低サポート OS
IPHONEOS_DEPLOYMENT_TARGET = 17.0
